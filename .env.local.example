# Firebase Configuration - Environment Variables
# Copy this file to .env.local and fill in your values from Firebase Console

# Get all these values from: Firebase Console → Project Settings ⚙️

# Firebase API Key
# Find in: Your apps → Web app → SDK setup and configuration
EXPO_PUBLIC_FIREBASE_API_KEY=YOUR_API_KEY_HERE

# Firebase Auth Domain
# Format: YOUR_PROJECT_ID.firebaseapp.com
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com

# Firebase Project ID
# Find in: Project Settings → General tab
EXPO_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID

# Firebase Storage Bucket
# Format: YOUR_PROJECT_ID.appspot.com
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com

# Firebase Messaging Sender ID
# Find in: Project Settings → Cloud Messaging tab
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID

# Firebase App ID
# Find in: Your apps → Copy from SDK setup
EXPO_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID

# Firebase Measurement ID (Optional, for Analytics)
# Find in: Your apps → Google Analytics section
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID

# Realtime Database URL
# Format: https://YOUR_PROJECT_ID.firebaseio.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://YOUR_PROJECT_ID.firebaseio.com


# ============================================================================
# HOW TO FILL THIS OUT:
# ============================================================================
#
# 1. Go to https://console.firebase.google.com
# 2. Select your ThunderControl project
# 3. Click the gear icon ⚙️ → Project Settings
# 4. Under "Your apps" section:
#    - Copy API Key → EXPO_PUBLIC_FIREBASE_API_KEY
#    - Copy App ID → EXPO_PUBLIC_FIREBASE_APP_ID
#    - Copy Project ID → EXPO_PUBLIC_FIREBASE_PROJECT_ID
#    - Auth Domain should be PROJECT_ID.firebaseapp.com
#    - Storage Bucket should be PROJECT_ID.appspot.com
#
# 5. For Messaging Sender ID:
#    - Go to Cloud Messaging tab in Project Settings
#    - Copy the Sender ID
#
# 6. For Database URL:
#    - Go to Realtime Database
#    - Copy the URL from top of page
#
# 7. For Measurement ID (optional):
#    - Look in your app's SDK configuration
#
# ============================================================================
# EXAMPLE (FILLED OUT):
# ============================================================================
#
# EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyDl5v_qQ8z7RxT9pKmL3OvW1YuZ4xAb5Cd
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=thundercontrol-p1a2b.firebaseapp.com
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=thundercontrol-p1a2b
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=thundercontrol-p1a2b.appspot.com
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
# EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcd1234efgh5678ijkl
# EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-ABC123DEFG
# EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://thundercontrol-p1a2b.firebaseio.com
#
# ============================================================================
# IMPORTANT:
# ============================================================================
# - Keep this file SECURE - never commit to git
# - Add to .gitignore: echo ".env.local" >> .gitignore
# - Restart app after changing: npx expo start (Ctrl+C then run again)
# - Changes take effect on next build
#
